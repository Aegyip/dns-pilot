<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DNS Pilot — WinUI 3 (Windows App SDK) arayüzü.
    DNS, erişim ve ayar mantığı ..\src altındaki dosyalardan bağlanır (link).
    Çıktı bin\winui\ klasörüne gider; kullanıcı dosyaları bir üstteki bin\ klasöründe aranır
    (src\Settings.cs: Settings.ResolveInstallDir).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>DnsPilot</RootNamespace>
    <AssemblyName>DnsPilot</AssemblyName>
    <AssemblyTitle>DNS Pilot</AssemblyTitle>
    <Product>DNS Pilot</Product>
    <Version>3.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\src\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Visual Studio olmadan (yalnızca dotnet CLI) derlerken PRI/MSIX araçları NuGet paketinden gelir. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Uygulama yalnızca Windows'ta çalışır; platform uyumluluğu uyarıları gereksiz. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <OutputPath Condition="'$(Configuration)' == 'Debug'">..\bin\winui\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\Dns.cs" Link="Shared\Dns.cs" />
    <Compile Include="..\src\Settings.cs" Link="Shared\Settings.cs" />
    <Compile Include="..\src\SiteList.cs" Link="Shared\SiteList.cs" />
    <Compile Include="..\src\LegacyCleanup.cs" Link="Shared\LegacyCleanup.cs" />
    <Compile Include="..\src\Shortcut.cs" Link="Shared\Shortcut.cs" />
    <Compile Include="..\src\BugReport.cs" Link="Shared\BugReport.cs" />
    <Compile Include="..\src\Diag.cs" Link="Shared\Diag.cs" />
    <Compile Include="..\src\ProcessRunner.cs" Link="Shared\ProcessRunner.cs" />
    <Compile Include="..\src\Bypass.cs" Link="Shared\Bypass.cs" />
    <Compile Include="..\src\DiscordFix.cs" Link="Shared\DiscordFix.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\src\app.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\src\icon\logo-256.png" Link="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.1.240916" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.1.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>

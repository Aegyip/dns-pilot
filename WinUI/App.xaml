<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DnsPilot.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Ayarlar uygulamasındaki gibi içerik alanı da Mica üzerinde (ayrı katman yok) -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />

            <!-- Windows Ayarlar sayfa ölçüleri -->
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Thickness x:Key="PagePadding">56,0,56,32</Thickness>
            <Thickness x:Key="SectionHeaderMargin">1,28,0,6</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>

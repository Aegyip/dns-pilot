<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DnsPilot.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DNS Pilot">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows Ayarlar gibi içerikle bütünleşik başlık çubuğu -->
        <Grid x:Name="AppTitleBar" Height="48" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/logo.png" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Text="DNS Pilot" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="280"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="860"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Giriş" Tag="Giriş">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Nav/home.svg" RasterizePixelWidth="40" RasterizePixelHeight="40" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="DNS" Tag="DNS">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Nav/dns.svg" RasterizePixelWidth="40" RasterizePixelHeight="40" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Erişim" Tag="Erisim">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Nav/access.svg" RasterizePixelWidth="40" RasterizePixelHeight="40" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sistem" Tag="Sistem">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Nav/system.svg" RasterizePixelWidth="40" RasterizePixelHeight="40" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Güncellemeler" Tag="Güncellemeler">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Nav/update.svg" RasterizePixelWidth="40" RasterizePixelHeight="40" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
